		)(symbol "khepri:FAN_4P" (pin_names (offset 1.016)) (exclude_from_sim no) (in_bom yes) (on_board yes) (property "Reference" "J" (at -2.54 6.35 0) (effects (font (size 1.27 1.27)) (justify left bottom))) (property "Value" "FAN_4P" (at -2.54 -6.35 0) (effects (font (size 1.27 1.27)) (justify left top))) (property "Footprint" "Connector_JST:JST_XH_B4B-XH-A_1x04_P2.50mm_Vertical" (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes))) (property "Datasheet" "" (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes))) (property "Description" "Ventilateur 8038 24 V 4 fils XH2.54 (1 rouge +, 2 noir -, 3 jaune tachy, 4 bleu PWM)" (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes))) (symbol "FAN_4P_0_1" (rectangle (start -2.54 5.08) (end 2.54 -5.08) (stroke (width 0.254) (type default)) (fill (type background)))) (symbol "FAN_4P_1_1" (pin passive line (at -5.08 3.81 0) (length 2.54) (name "V+" (effects (font (size 1.27 1.27)))) (number "1" (effects (font (size 1.27 1.27))))) (pin passive line (at -5.08 1.27 0) (length 2.54) (name "GND" (effects (font (size 1.27 1.27)))) (number "2" (effects (font (size 1.27 1.27))))) (pin passive line (at -5.08 -1.27 0) (length 2.54) (name "TACH" (effects (font (size 1.27 1.27)))) (number "3" (effects (font (size 1.27 1.27))))) (pin passive line (at -5.08 -3.81 0) (length 2.54) (name "PWM" (effects (font (size 1.27 1.27)))) (number "4" (effects (font (size 1.27 1.27))))) ) (embedded_fonts no) )) (text "VENTILATION - aspiration de l air interieur, rejet au fond de l instrument a travers le dissipateur de la BSR Drive\nVentilateur 8038 (80x80x38) 24 V 4 fils PWM + tachy, connecteur JST XH 4P (J25) en bas de carte, alimente par le +24V interne (U2).\nPWM 25 kHz open-drain par Q15 depuis IO15 (au boot IO15 haut -> PWM bas -> ventilo lent). Tachy (2 impulsions/tour) sur IO39 (entree seule).\nBrochage XH suppose : 1 rouge +24V, 2 noir GND, 3 jaune tachy, 4 bleu PWM - A VERIFIER sur le ventilateur recu." (exclude_from_sim no) (at 20.32 15.24 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "9e2f96f4-63ae-44b4-a6d9-a6e462bfba19"))
