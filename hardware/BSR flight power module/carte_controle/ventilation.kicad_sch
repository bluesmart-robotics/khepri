		)(symbol "khepri:FAN_4P" (pin_names (offset 1.016)) (exclude_from_sim no) (in_bom yes) (on_board yes) (property "Reference" "J" (at -2.54 6.35 0) (effects (font (size 1.27 1.27)) (justify left bottom))) (property "Value" "FAN_4P" (at -2.54 -6.35 0) (effects (font (size 1.27 1.27)) (justify left top))) (property "Footprint" "Connector:FanPinHeader_1x04_P2.54mm_Vertical" (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes))) (property "Datasheet" "" (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes))) (property "Description" "Ventilateur 4 fils PWM (standard PC : 1 GND, 2 +12V, 3 tachy, 4 PWM)" (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes))) (symbol "FAN_4P_0_1" (rectangle (start -2.54 5.08) (end 2.54 -5.08) (stroke (width 0.254) (type default)) (fill (type background)))) (symbol "FAN_4P_1_1" (pin passive line (at -5.08 3.81 0) (length 2.54) (name "GND" (effects (font (size 1.27 1.27)))) (number "1" (effects (font (size 1.27 1.27))))) (pin passive line (at -5.08 1.27 0) (length 2.54) (name "+12V" (effects (font (size 1.27 1.27)))) (number "2" (effects (font (size 1.27 1.27))))) (pin passive line (at -5.08 -1.27 0) (length 2.54) (name "TACH" (effects (font (size 1.27 1.27)))) (number "3" (effects (font (size 1.27 1.27))))) (pin passive line (at -5.08 -3.81 0) (length 2.54) (name "PWM" (effects (font (size 1.27 1.27)))) (number "4" (effects (font (size 1.27 1.27))))) ) (embedded_fonts no) )) (text "VENTILATION - aspiration de l air interieur, rejet au fond de l instrument a travers le dissipateur de la BSR Drive\nVentilateur 80x80x25 12 V 0.5 A 4 fils PWM (GDSTIME 5000 tr/min, 63 CFM, 0.48 inH2O) - connecteur J25 en bas de carte.\nPWM 25 kHz open-drain par Q15 depuis IO15 (au boot IO15 haut -> PWM bas -> ventilo lent). Tachy (2 impulsions/tour) sur IO39 (entree seule).\n+12V : rail a creer (point 3, avec chaussettes et servos) - prevoir un eFuse dedie ventilateur ~1 A.\nATTENTION polarite : GDSTIME annonce 1 rouge +, 2 noir - ; le standard PC est 1 GND, 2 +12V. Verifier le connecteur recu." (exclude_from_sim no) (at 20.32 15.24 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3f6e8f75-9581-4543-a0de-8d9e9b192890"))
