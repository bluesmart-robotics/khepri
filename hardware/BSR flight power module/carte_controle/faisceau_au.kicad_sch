4) (end 2.54 -2.54) (stroke (width 0.254) (type default)) (fill (type background)))) (symbol "JUMPER_2_1_1" (pin passive line (at -5.08 1.27 0) (length 2.54) (name "1" (effects (font (size 1.27 1.27)))) (number "1" (effects (font (size 1.27 1.27))))) (pin passive line (at -5.08 -1.27 0) (length 2.54) (name "2" (effects (font (size 1.27 1.27)))) (number "2" (effects (font (size 1.27 1.27))))) ) (embedded_fonts no) )) (text "FAISCEAU CHAUSSETTES, ARRET D URGENCE, TIGES DE PUISSANCE\nJ17 : XT60 2+4 vers la BSR Drive (puissance + CAN), inchangee.\nU43 LM5146 : +24V_EXT 10 A pour le faisceau, active seulement si ESTOP_OK ET EXT_ON (U44) -> coupe si l instrument est eteint.\nJ26 Micro-Fit 6 vers le DTM 6 voies : 1-2 +24V_EXT, 3-4 GND, 5 CANH, 6 CANL. JP1 : terminaison CAN 120 ohms (cavalier).\nJ27 : bouton d arret d urgence du tableau (contact NF). Ouvert -> ESTOP_OK bas -> BSR Drive (J28.4) et faisceau coupes.\nU42 PCA9555 (0x20, canal 4 du TCA9548A) : EXT_ON, SOFT_STOP (arret logiciel), lecture ESTOP_OK et EXT_PGOOD." (exclude_from_sim no) (at 20.32 12.70 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "37c0e4f9-aa4d-4cdc-b337-a54f6de28e9b"))






