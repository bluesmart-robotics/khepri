menu "KHEPRI - ecran pilote"

    config KHEPRI_ESPNOW_CHANNEL
        int "Canal Wi-Fi de la liaison ESP-NOW"
        range 1 13
        default 1
        help
            Doit etre identique sur l'ecran et sur le maitre (ou la passerelle de simulation).

    config KHEPRI_DEMO_DEFAULT
        bool "Simulation locale active au premier demarrage"
        default y
        help
            L'ecran genere lui-meme des donnees plausibles (badge SIMULATION) tant qu'on ne
            l'a pas desactivee depuis la page SYSTEME. Le choix est ensuite memorise en NVS.
            A desactiver avant tout vol.

    config KHEPRI_PUSH_MG
        int "Geste : seuil du petit coup vers l'arriere (mg)"
        range 100 2000
        default 350

    config KHEPRI_PUSH_INVERT
        bool "Geste : inverser le sens de la poussee (axe Z)"
        default n

    config KHEPRI_ROLL_DEAD_DEG
        int "Roulis : zone morte (degres)"
        range 0 45
        default 8

    config KHEPRI_ROLL_FULL_DEG
        int "Roulis : angle donnant la vitesse maximale (degres)"
        range 10 90
        default 40

    config KHEPRI_ROLL_RATE_PCT_S
        int "Roulis : vitesse maximale de variation du regime (%/s)"
        range 5 200
        default 40

    config KHEPRI_ROLL_INVERT
        bool "Roulis : inverser droite / gauche"
        default n

    config KHEPRI_THRUST_REF_W
        int "Puissance electrique totale (W) affichee comme 100 % de poussee"
        range 500 20000
        default 3500
        help
            Somme M0 + M1 de la puissance de bus (U x I) mesuree par le BSR Drive
            (trame CANSimple Get_Bus_Voltage_Current, 0x017). L'affichage peut depasser 100 %.

    config KHEPRI_ODRV_NODE_M0
        int "Noeud CANSimple du BSR Drive pour le moteur M0"
        range 0 63
        default 0

    config KHEPRI_ODRV_NODE_M1
        int "Noeud CANSimple du BSR Drive pour le moteur M1"
        range 0 63
        default 1

    config KHEPRI_OTA_MANIFEST_URL
        string "OTA : adresse du manifeste version.json"
        default "https://raw.githubusercontent.com/bluesmart-robotics/khepri/main/IHM/code/release/version.json"

    config KHEPRI_OTA_PERIOD_S
        int "OTA : periode de verification (s)"
        range 30 86400
        default 60

endmenu
