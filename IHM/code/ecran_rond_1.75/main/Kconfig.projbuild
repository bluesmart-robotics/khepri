menu "KHEPRI - ecran rond 1.75 (regime moteur)"

    choice KHEPRI_BOARD
        prompt "Carte"
        default KHEPRI_BOARD_WAVESHARE
        help
            Waveshare : carte ESP32-S3-Touch-AMOLED-1.75(-G) du commerce (AXP2101, bouton PWR
            lu sur le TCA9554, accelerometre QMI8658).
            BSR : carte ecran rond KHEPRI (hardware/BSR flight power module/ecran_rond_1.75) :
            pas de PMU ni d'accelerometre, bouton = BOOT (GPIO0), UART1 vers la carte facade
            sur GPIO17 (TX) / GPIO18 (RX).

        config KHEPRI_BOARD_WAVESHARE
            bool "Waveshare ESP32-S3-Touch-AMOLED-1.75"
        config KHEPRI_BOARD_BSR
            bool "Carte ecran rond KHEPRI (BSR)"
    endchoice

    config KHEPRI_FACADE_UART_BAUD
        int "UART facade : vitesse (bauds)"
        depends on KHEPRI_BOARD_BSR
        range 9600 2000000
        default 115200

    config KHEPRI_DEMO_DEFAULT
        bool "Simulation locale active au premier demarrage"
        default y
        help
            L'ecran genere lui-meme des donnees plausibles (badge SIMULATION) tant qu'on ne
            l'a pas desactivee depuis la page SYSTEME. Le choix est ensuite memorise en NVS.
            A desactiver avant tout vol.

    config KHEPRI_PUSH_MG
        int "Geste : seuil du petit coup vers l'arriere (mg)"
        range 50 2000
        default 120

    config KHEPRI_PUSH_INVERT
        bool "Geste : inverser le sens de la poussee (axe Z)"
        default n

    config KHEPRI_ROLL_DEAD_DEG
        int "Roulis : zone morte (degres)"
        range 0 45
        default 3

    config KHEPRI_ROLL_FULL_DEG
        int "Roulis : angle donnant la vitesse maximale (degres)"
        range 5 90
        default 13

    config KHEPRI_ROLL_RATE_PCT_S
        int "Roulis : vitesse maximale de variation du regime (%/s)"
        range 5 200
        default 40

    config KHEPRI_ROLL_INVERT
        bool "Roulis : inverser droite / gauche"
        default n

endmenu
