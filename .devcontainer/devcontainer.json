{
	"name": "ESP-IDF QEMU",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash",
				"idf.gitPath": "/usr/bin/git"
			},
			"extensions": [
				"espressif.esp-idf-extension",
				"espressif.esp-idf-web",
				"ms-vscode.cpptools"
			]
		}
	},
	"runArgs": 	["--privileged",
				"--device=/dev/ttyS4:/dev/ttyUSB0",
				"--device=/dev/ttyUSB1:/dev/ttyUSB1"
				]
}